generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  activities  Activity[]
  members     Member[]
  tasks       Task[]

  @@map("projects")
}

model Member {
  id                  String           @id @default(cuid())
  name                String
  role                String?
  email               String?
  projectId           String           @map("project_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  activities          Activity[]
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluationsGiven    PeerEvaluation[] @relation("Evaluator")
  evaluationsReceived PeerEvaluation[] @relation("TargetMember")
  tasks               Task[]
  workLogs            WorkLog[]

  @@index([projectId])
  @@map("members")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String?
  hours       Float        @default(0)
  progress    Int          @default(0)
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  projectId   String       @map("project_id")
  memberId    String?      @map("member_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  activities  Activity[]
  member      Member?      @relation(fields: [memberId], references: [id])
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workLogs    WorkLog[]

  @@index([projectId])
  @@index([memberId])
  @@map("tasks")
}

model WorkLog {
  id          String   @id @default(cuid())
  hours       Float
  description String?
  workDate    DateTime @map("work_date")
  memberId    String   @map("member_id")
  taskId      String   @map("task_id")
  createdAt   DateTime @default(now()) @map("created_at")
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([taskId])
  @@map("work_logs")
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  projectId String   @map("project_id")
  memberId  String   @map("member_id")
  taskId    String?  @map("task_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id])

  @@index([projectId])
  @@index([memberId])
  @@index([taskId])
  @@map("activities")
}

model PeerEvaluation {
  id             String   @id @default(cuid())
  evaluatorId    String   @map("evaluator_id")
  targetMemberId String   @map("target_member_id")
  responsibility Int
  communication  Int
  teamwork       Int
  quality        Int
  createdAt      DateTime @default(now()) @map("created_at")
  evaluator      Member   @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  targetMember   Member   @relation("TargetMember", fields: [targetMemberId], references: [id], onDelete: Cascade)

  @@index([evaluatorId])
  @@index([targetMemberId])
  @@map("peer_evaluations")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

