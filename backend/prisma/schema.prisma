generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  activities  Activity[]
  members     Member[]
  tasks       Task[]

  @@map("projects")
}

model Member {
  id                  String           @id @default(cuid())
  name                String
  role                String?
  email               String?
  projectId           String           @map("project_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  activities          Activity[]
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "members_projectId_fkey")
  evaluationsGiven    PeerEvaluation[] @relation("Evaluator")
  evaluationsReceived PeerEvaluation[] @relation("TargetMember")
  tasks               Task[]
  workLogs            WorkLog[]

  @@index([projectId], map: "members_projectId_idx")
  @@map("members")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String?
  hours       Float        @default(0)
  progress    Int          @default(0)
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  projectId   String       @map("project_id")
  memberId    String?      @map("member_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  activities  Activity[]
  member      Member?      @relation(fields: [memberId], references: [id], map: "tasks_memberId_fkey")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "tasks_projectId_fkey")
  workLogs    WorkLog[]

  @@index([memberId], map: "tasks_memberId_idx")
  @@index([projectId], map: "tasks_projectId_idx")
  @@map("tasks")
}

model WorkLog {
  id          String   @id @default(cuid())
  hours       Float
  description String?
  workDate    DateTime @map("work_date")
  memberId    String   @map("member_id")
  taskId      String   @map("task_id")
  createdAt   DateTime @default(now()) @map("created_at")
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "work_logs_memberId_fkey")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "work_logs_taskId_fkey")

  @@index([memberId], map: "work_logs_memberId_idx")
  @@index([taskId], map: "work_logs_taskId_idx")
  @@map("work_logs")
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  projectId String   @map("project_id")
  memberId  String   @map("member_id")
  taskId    String?  @map("task_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "activities_memberId_fkey")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "activities_projectId_fkey")
  task      Task?    @relation(fields: [taskId], references: [id], map: "activities_taskId_fkey")

  @@index([memberId], map: "activities_memberId_idx")
  @@index([projectId], map: "activities_projectId_idx")
  @@index([taskId], map: "activities_taskId_idx")
  @@map("activities")
}

model PeerEvaluation {
  id             String   @id @default(cuid())
  evaluatorId    String   @map("evaluator_id")
  targetMemberId String   @map("target_member_id")
  responsibility Int
  communication  Int
  teamwork       Int
  quality        Int
  createdAt      DateTime @default(now()) @map("created_at")
  evaluator      Member   @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade, map: "peer_evaluations_evaluatorId_fkey")
  targetMember   Member   @relation("TargetMember", fields: [targetMemberId], references: [id], onDelete: Cascade, map: "peer_evaluations_targetMemberId_fkey")

  @@index([evaluatorId], map: "peer_evaluations_evaluatorId_idx")
  @@index([targetMemberId], map: "peer_evaluations_targetMemberId_idx")
  @@map("peer_evaluations")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}


model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}


enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  ADMIN
  USER
}

